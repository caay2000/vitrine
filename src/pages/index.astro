---
import Base from '../layouts/Base.astro';
import { listItems, listTags } from '../lib/db';
import { site, t } from '../lib/site';

const tags = await listTags();
// An unknown tag in the URL is ignored rather than showing an empty page.
const activeTag = tags.find((tag) => tag.slug === Astro.url.searchParams.get('tag'));
const items = await listItems({ tag: activeTag?.slug });
// Item links carry the filter, so previous/next on the item page stay within it.
const query = activeTag ? `?tag=${activeTag.slug}` : '';
---

<Base>
	<section class="hero">
		<p class="eyebrow">{items.length} {t.items}{activeTag && ` · ${activeTag.name}`}</p>
		<h1>{site.title}</h1>
		<p class="lead">{site.description}</p>
	</section>

	{
		tags.length > 0 && (
			<nav class="tags" aria-label={t.tags}>
				<a class="chip" href="/" aria-current={activeTag ? undefined : 'true'}>
					{t.all}
				</a>
				{tags.map((tag) => (
					<a class="chip" href={`/?tag=${tag.slug}`} aria-current={tag.slug === activeTag?.slug ? 'true' : undefined}>
						{tag.name} <span class="count">{tag.count}</span>
					</a>
				))}
			</nav>
		)
	}

	{items.length === 0 && <p class="empty">{t.empty}</p>}
	<ul class="grid">
		{
			items.map((item, i) => (
				<li>
					<a href={`/item/${item.slug}${query}`}>
						<div class="frame">
							{item.cover && (
								<img
									src={`/img/${item.cover}`}
									alt=""
									loading={i < 8 ? 'eager' : 'lazy'}
									decoding="async"
									style={`view-transition-name: photo-${item.id}`}
								/>
							)}
						</div>
						<h2>{item.title}</h2>
					</a>
				</li>
			))
		}
	</ul>
</Base>

<style>
	.hero {
		max-width: 46rem;
		padding: 2rem 0 2.25rem;
	}

	.eyebrow {
		margin: 0 0 0.6rem;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.hero h1 {
		margin: 0;
		font-size: clamp(2.5rem, 7vw, 4.25rem);
		font-weight: 400;
		letter-spacing: -0.025em;
		line-height: 1.02;
	}

	.lead {
		margin: 1rem 0 0;
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		color: var(--muted);
	}

	/* One scrollable row on small screens, wrapping on larger ones. */
	.tags {
		display: flex;
		gap: 0.5rem;
		margin: 0 -1.25rem;
		padding: 0.25rem 1.25rem 1rem;
		overflow-x: auto;
		scrollbar-width: none;
	}

	@media (min-width: 48rem) {
		.tags {
			flex-wrap: wrap;
			overflow: visible;
		}
	}

	.count {
		font-size: 0.8em;
		opacity: 0.55;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
		gap: 2rem 1.5rem;
		padding: 0;
		margin: 1rem 0 0;
		list-style: none;
	}

	.grid a {
		display: block;
		color: var(--text);
		text-decoration: none;
	}

	.frame {
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: var(--surface-2);
		border-radius: var(--radius);
		box-shadow: 0 1px 2px var(--shadow);
		transition:
			box-shadow 0.3s,
			transform 0.3s;
	}

	.frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.grid a:hover .frame,
	.grid a:focus-visible .frame {
		box-shadow: 0 14px 30px -12px var(--shadow);
		transform: translateY(-3px);
	}

	.grid a:hover img {
		transform: scale(1.05);
	}

	.grid h2 {
		margin: 0.75rem 0 0;
		font-size: 1.1rem;
		line-height: 1.3;
		letter-spacing: 0;
		transition: color 0.15s;
	}

	.grid a:hover h2 {
		color: var(--accent);
	}
</style>
